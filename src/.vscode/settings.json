{
    "editor.unicodeHighlight.includeComments": true,
    "editor.minimap.enabled": false,
    "editor.fontFamily": "Consolas",
    "editor.fontSize": 16,
    "editor.fontWeight": "normal",
    "editor.unicodeHighlight.allowedCharacters": {
        ";": true
    },
    "workbench.colorCustomizations": {
        // "activityBar.foreground":"#1678c9",
        "editor.lineHighlightBorder": "#abb2bf",
    },
        // {
        //     "scope":[
        //         "keyword.control.gbz80","support.function.gbz80","keyword.other.opcode.gbz80"
        //         ],
        //         "settings":{
        //             "fontFamily": "Bahnschrift",
        //         }
        //     },       
     "editor.tokenColorCustomizations":{
        "textMateRules":[
        {
            "scope":[
                "string.quoted.double.asm","comment.line.asm"
                ],
                "settings":{
                    "fontStyle": "italic",
                }
            },
        {
            "scope":[
                "variable.parameter.label.asm"
                ],
                "settings":{
                    "background": "#ff0a0a",
                }
            },    
        ],
        "strings": "#ccccaf",
        "numbers": "#FFFFFF",
    },
        "highlight.regexes": {
            "(// ?TODO:?)(.*)": [
                {
                "overviewRulerColor": "#ffcc00",
                "backgroundColor": "#ffcc00",
                "color": "#1f1f1f",
                "fontWeight": "bold"
                },
                {
                "backgroundColor": "#d9ad00",
                "color": "#1f1f1f"
                }
            ],
            "(jp)(.*)": [
                {
                "color": "#ffcc00ff",
                },
            ],
            "(jr)(.*)": [
                {
                "color": "#ff8800ff",
                },
            ],
            "(ret)(.*)": [
                {
                "color": "#ff0000ff",
                },
            ],
            "(Effect:)(.*)": [
                {
                "color": "#18b912ff",
                "backgroundColor": "#101010",
                },
            ],
            "(Card:)(.*)": [
                {
                "color": "#18b912ff",
                },
            ],
            "(GRASS)(.*)": [
                {
                "color": "#18b912ff",
                },
            ],
            "(WATER)(.*)": [
                {
                "color": "#00a2ffff",
                },
            ],
            "(FIRE)(.*)": [
                {
                "color": "#ff8800ff",
                },
            ],
            "(LIGHTNING)(.*)": [
                {
                "color": "#ffcc00ff",
                },
            ],
            "(FIGHTING)(.*)": [
                {
                "color": "#ff0000ff",
                },
            ],
            "(PSYCHIC)(.*)": [
                {
                "color": "#FF0066",
                },
            ],
            "(DARKNESS)(.*)": [
                {
                "color": "#7030A0",
                },
            ],
            "(METAL)(.*)": [
                {
                "color": "#a4a49f",
                },
            ],
            "(COLORLESS)(.*)": [
                {
                "color": "#a8a878",
                },
            ],
    },
    "editor.language.colorizedBracketPairs": []
}
